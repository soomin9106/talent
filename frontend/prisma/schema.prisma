generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "postgresql"
  // Uses connection pooling
  url = env("POSTGRES_PRISMA_URL")
  // Uses direct connection, ⚠️ make sure to keep this to `POSTGRES_URL_NON_POOLING`
  // or you'll have dangling databases from migrations
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Cell {
  id        Int       @id @default(autoincrement())
  name      String
  teachers  Teacher[] @relation("CellTeachers")
  children  Child[]   @relation("CellChildren")
}

model Teacher {
  id          Int                 @id @default(autoincrement())
  name        String
  cellId      Int?
  cell        Cell?               @relation("CellTeachers", fields: [cellId], references: [id])
  attendances TeacherAttendance[]
}

// status: PRESENT(출석) | ABSENT(결석) | PRAYER(기도참석)
model TeacherAttendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  status    String   @default("ABSENT")
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, date])
}

model Child {
  id          Int          @id @default(autoincrement())
  name        String
  grade       Int
  zone        String
  talent      Int
  cellId      Int
  cell        Cell         @relation("CellChildren", fields: [cellId], references: [id])
  attendances Attendance[]
}

// status: PRESENT(출석) | LATE(지각) | ABSENT(결석)
model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean  @default(true)
  status  String   @default("ABSENT")
  childId Int
  child   Child    @relation(fields: [childId], references: [id])

  @@unique([childId, date])
}